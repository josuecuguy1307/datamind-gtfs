# Python
__pycache__/
*.pyc

# Virtual environments
.venv/
venv/
env/

# Environment variables
.env

# macOS
.DS_Store

# Jupyter
.ipynb_checkpoints/

# Datos y salidas de corridas (solo en la raíz; los paquetes de CÓDIGO llamados
# models/, data/ o logs/ SÍ deben versionarse)
/data/
/logs/
/backups/
/constructor_artifacts/
/benchmark_output*/
/workspace/*
!/workspace/config/
!/workspace/README.md


# Dumps y copias de la base (pueden pesar GB y contener datos reales)
backups/
**/_backups/
*.dump
*.sql.gz
*.zip

# Salidas generadas de las corridas de pipeline
phase*/out/

# Estado local de herramientas y cachés
.claude/
.cache/
.pytest_cache/
.streamlit/secrets.toml
.env.*
!.env.example

# Modelos entrenados (binarios) y datos de entrenamiento: NO se versionan.
# Ojo: solo se ignoran archivos de datos; el CÓDIGO de los paquetes `models/` sí va en git.
*.pkl
*.joblib
*.model
**/models/*.txt
**/models/**/*.txt
**/models/*.csv
**/models/*.jsonl

# Run logs generated by the console and the tests
datamind_console/orchestrator_logs/

# local_runner working folders (keep only the .gitkeep placeholders)
local_runner/done/*
local_runner/failed/*
local_runner/inbox/*
local_runner/processing/*
local_runner/results/*
!local_runner/*/.gitkeep
