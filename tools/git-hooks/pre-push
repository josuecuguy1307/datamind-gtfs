#!/bin/sh
# Refuse a push that would send a commit containing a secret.
#
# Install once per clone:   cp tools/git-hooks/pre-push .git/hooks/pre-push
# Git passes one line per ref on stdin: <local ref> <local sha> <remote ref> <remote sha>.
# Only the commits no remote has yet are scanned. Findings print a fingerprint,
# never the value. See docs/SECURITY_HYGIENE.md for what to do next.
repo_root=$(git rev-parse --show-toplevel) || exit 1
zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue  # deleting a remote ref sends no commits
    if ! python3 "$repo_root/tools/secret_scan.py" --push "$local_sha" "$remote_sha"; then
        echo "pre-push: refusing to push $local_ref: the commits listed above contain a secret." >&2
        status=1
    fi
done
exit $status
