# =====================================================================
#  DataMind GTFS — environment variables
#
#  1) Copy this file:   cp .env.example .env
#  2) Put in YOUR OWN values (database, keys, hosts). Nothing here comes "out of the
#     box": the code stops with a clear message if a required value is missing.
#  3) NEVER commit .env to Git (it is already ignored).
#
#  MINIMUM to start locally with the sample data:
#      DB_DSN=...   DATA_MODE=local   DATAMIND_LOCAL_ONLY_MODE=true   LOCAL_DB_DSN=... (same as DB_DSN)
#  Everything else is optional and switched on per feature (AI, GTFS publishing, AWS, WhatsApp…).
#  At the end of the file are ALL the other variables the code reads, with where they come from.
# =====================================================================

# --- Database (REQUIRED) ---------------------------------------------
# DSN of your PostgreSQL with PostGIS + pgvector. Format:
#   postgresql://USER:PASSWORD@HOST:PORT/DB_NAME?sslmode=require
# Without it, every script and the console fail with a message that says so.
DB_DSN=postgresql://USER:PASSWORD@127.0.0.1:5432/datamind_ml
# Legacy alias accepted by some modules (leave empty if you use DB_DSN)
DATABASE_URL=

# Data mode for console runtime routing
# local -> uses LOCAL_DB_DSN (fallback server)
# server -> uses SERVER_DB_DSN / Supabase vars
# Locally with the sample data use: local
DATA_MODE=server
# With DATA_MODE=local: DSN of your local database (usually the same as DB_DSN)
LOCAL_DB_DSN=
# With DATA_MODE=server: DSN of the server database
SERVER_DB_DSN=

# Supabase split vars (used to build DSN automatically when DB_DSN is empty)
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=

# Shared schemas
SCHEMA_CONSOLE=console
SCHEMA_NODE_RAW=node_raw
SCHEMA_NODE_WORK=node_work
SCHEMA_NODE_PROD=node_prod
SCHEMA_GEO_RAW=geo_raw
SCHEMA_GEO_WORK=geo_work
SCHEMA_GEO_PROD=geo_prod
SCHEMA_ROUTE_RAW=route_raw
SCHEMA_ROUTE_WORK=route_work
SCHEMA_ROUTE_PROD=route_prod
SCHEMA_SEMANTICS=semantics

# Geo API (commercial endpoints)
# Base URL of your Geo API (leave empty to use http://127.0.0.1:8006 locally)
GEO_API_BASE_URL=
GEO_API_PUBLIC_BASE_URL=
GEO_API_TIMEOUT_S=20

# Services (local-first: self-hosted Overpass via Docker on port 12346)
OVERPASS_URL=http://127.0.0.1:12346/api/interpreter
VALHALLA_URL=http://127.0.0.1:8003
OPENSEARCH_URL=http://127.0.0.1:9200
OPENSEARCH_USER=
OPENSEARCH_PASS=

# App
APP_ENV=dev
LOG_LEVEL=INFO
OPENAI_API_KEY=
DATAMIND_CHATGPT_MODEL=gpt-5.2
# Visible product name is ML DATAMIND GTFS. Existing DATAMIND_* keys remain for compatibility.
DATAMIND_CONSOLE_APP_NAME=ML DATAMIND GTFS
# Local interactive terminal launcher. Keep false on shared/server hosts.
ML_DATAMIND_LOCAL_CLI_LAUNCH_ENABLED=false
# Local UI is account-free only while Streamlit is bound to loopback.
# Set this to true only for an intentionally remote deployment; that path keeps login/session controls.
ML_DATAMIND_REMOTE_UI=false
# true = the console opens without login and without requiring a server DB (only valid if Streamlit listens on 127.0.0.1)
DATAMIND_LOCAL_ONLY_MODE=false

# -----------------------------
# GTFS Ops (Local + AWS)
# -----------------------------
# Optional explicit path to your transport backend repo (where docker-compose.yaml lives)
GTFS_APP_ROOT=

# Local GTFS publish commands
# Command must import GTFS ZIP into local DB (idempotent preferred)
# GTFS_ZIP_PATH and GTFS_EXTRACT_DIR are exported for this command.
# Leave empty to use built-in importer (loads GTFS TXT files into gtfs.* tables).
LOCAL_GTFS_IMPORT_CMD=
# Optional dedicated DSN for GTFS ops target DB (the downstream app DB).
# If empty, widget falls back to LOCAL_DB_DSN only when DB name is the downstream app DB;
# otherwise it auto-detects gtfs_app/.env + PG_HOST_PORT when available.
LOCAL_GTFS_DB_DSN=
# SQL statements run after import (e.g. refresh services/fts/indexes)
LOCAL_DB_REFRESH_SQL=

# Local OTP + GTFS paths
LOCAL_GTFS_INCOMING_DIR=
LOCAL_GTFS_EXTRACT_DIR=
OTP_LOCAL_MODE=
OTP_LOCAL_SERVICE_NAME=otp
OTP_LOCAL_SYSTEMD_UNIT=otp
OTP_LOCAL_PORT=8080
OTP_LOCAL_HEALTH_URL=
OTP_LOCAL_BUILD_CMD=
OTP_LOCAL_BUILD_XMX=2G

# AWS SSH access
AWS_SSH_HOST=
AWS_SSH_USER=
AWS_SSH_KEY_PATH=
AWS_SSH_CONFIG_NAME=
AWS_SSH_PORT=22
SSH_STRICT_HOST_KEY_CHECKING=false

# AWS GTFS apply paths/commands
AWS_GTFS_INCOMING_DIR=/data/gtfs/incoming
AWS_GTFS_EXTRACT_DIR=
# Optional custom remote command to apply GTFS
# GTFS_REMOTE_ZIP and AWS_GTFS_EXTRACT_DIR are exported for this command.
AWS_GTFS_APPLY_CMD=

# AWS OTP controls
AWS_TRANSPORTAPP_DIR=/opt/gtfs_app
OTP_AWS_MODE=
OTP_AWS_SERVICE_NAME=otp
OTP_AWS_SYSTEMD_UNIT=otp
OTP_AWS_HEALTH_URL=
OTP_AWS_BUILD_CMD=
OTP_AWS_BUILD_XMX=2G
# By default, AWS publish expects a local graph.obj (built by LOCAL publish) and uploads it.
# Set true only if you explicitly want to allow long remote graph builds on EC2.
AWS_ALLOW_REMOTE_OTP_BUILD=false

# Backend code push (local gtfs_app -> AWS)
# Local source defaults to GTFS_APP_ROOT.
BACKEND_PUSH_LOCAL_DIR=
# Remote app root where BACKEND folder is replaced (defaults to AWS_TRANSPORTAPP_DIR).
AWS_BACKEND_REMOTE_DIR=
# Optional explicit deploy command after upload (if empty, auto-detect compose/container/systemd).
AWS_BACKEND_DEPLOY_CMD=
AWS_BACKEND_SERVICE_NAME=backend
AWS_BACKEND_SYSTEMD_UNIT=backend
# Docker services restarted/redeployed in compose mode.
AWS_BACKEND_DEPLOY_SERVICES=backend,otp

# AWS DB import/refresh/status
# Optional custom import command (runs on EC2 over SSH before OTP build).
# AWS_GTFS_EXTRACT_DIR and GTFS_REMOTE_ZIP are exported to this command.
AWS_DB_IMPORT_CMD=
# Refresh strategy:
# If AWS_DB_DSN and AWS_DB_STATUS_CMD are empty, status auto-tries:
# SSH -> source .env -> docker exec postgres psql.
AWS_DB_DSN=
AWS_DB_REFRESH_CMD=
AWS_DB_STATUS_CMD=

# -----------------------------
# AI Learning Agent
# -----------------------------
# Worker decision mode:
# - heuristics (default): rule-based suggestions
# - model: load active model from ai.ai_model_registry (or explicit version below)
AI_DECIDER=heuristics
# Optional explicit model version override (e.g., baseline_logreg_20260224T120000Z).
AI_ACTIVE_MODEL_VERSION=
# Minimum confidence required before creating a suggestion row.
AI_MIN_CONFIDENCE=0.30
# Optional fallback only when schedule table is unavailable.
AI_SCHEDULE_ENABLED=false

# Escalation-to-Codex integration (OFF by default)
AI_ESCALATION_ENABLED=false
CODEX_API_URL=
CODEX_API_KEY=
CODEX_MODEL=gpt-5.2-codex

# -----------------------------
# Approval-gated GTFS exports + WhatsApp
# -----------------------------
WHATSAPP_ENABLED=false
WHATSAPP_ADMIN_NUMBER=
META_WA_PHONE_NUMBER_ID=
META_WA_ACCESS_TOKEN=
META_WA_VERIFY_TOKEN=
PUBLIC_WEBHOOK_BASE_URL=

# API base used by local downloader / dashboard HTTP actions
DATAMIND_BASE_URL=http://127.0.0.1:8006
DATAMIND_API_KEY=

# Desktop downloader target (default can be overridden)
DOWNLOAD_DIR=

# =====================================================================
#  ALL THE OTHER VARIABLES (generated from the code)
#  Each one is OPTIONAL: shown commented out with its default value (if it is a
#  literal) and the file where it is read, so you know what it controls. Uncomment and
#  change only what you need.
# =====================================================================

