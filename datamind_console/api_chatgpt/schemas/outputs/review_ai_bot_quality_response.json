{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReviewAIBotQualityResponse",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mode",
    "task",
    "summary",
    "confidence",
    "risk_flags",
    "insufficient_data_flags",
    "operator_confirmation_required",
    "evidence_used",
    "quality_assessment",
    "top_weaknesses",
    "tuning_suggestions",
    "logging_gaps",
    "prioritized_improvements"
  ],
  "properties": {
    "mode": {"type": "string", "const": "advisory_only"},
    "task": {"type": "string", "const": "review_ai_bot_quality"},
    "summary": {"type": "string", "minLength": 1, "maxLength": 5000},
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["band", "score", "reasons"],
      "properties": {
        "band": {"type": "string", "enum": ["low", "medium", "high"]},
        "score": {"type": "number", "minimum": 0, "maximum": 1},
        "reasons": {
          "type": "array",
          "items": {"type": "string", "maxLength": 500},
          "maxItems": 12
        }
      }
    },
    "risk_flags": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "severity", "message"],
        "properties": {
          "code": {"type": "string", "maxLength": 120},
          "severity": {"type": "string", "enum": ["low", "medium", "high"]},
          "message": {"type": "string", "maxLength": 800}
        }
      },
      "maxItems": 25
    },
    "insufficient_data_flags": {
      "type": "array",
      "items": {"type": "string", "maxLength": 200},
      "maxItems": 25
    },
    "operator_confirmation_required": {"type": "boolean"},
    "evidence_used": {
      "type": "array",
      "items": {"type": "string", "maxLength": 120},
      "maxItems": 60
    },
    "quality_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["overall_rating", "signal_to_noise_ratio", "coverage_assessment", "readiness_bottleneck"],
      "properties": {
        "overall_rating": {"type": "string", "enum": ["weak", "fair", "strong"]},
        "signal_to_noise_ratio": {"type": "number", "minimum": 0, "maximum": 1},
        "coverage_assessment": {"type": "string", "maxLength": 1200},
        "readiness_bottleneck": {"type": "string", "maxLength": 1200}
      }
    },
    "top_weaknesses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["weakness_id", "title", "severity", "description", "evidence_refs"],
        "properties": {
          "weakness_id": {"type": "string", "maxLength": 120},
          "title": {"type": "string", "maxLength": 300},
          "severity": {"type": "string", "enum": ["low", "medium", "high"]},
          "description": {"type": "string", "maxLength": 1200},
          "evidence_refs": {
            "type": "array",
            "items": {"type": "string", "maxLength": 120},
            "maxItems": 20
          }
        }
      },
      "maxItems": 20
    },
    "tuning_suggestions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["suggestion_id", "description", "expected_effect", "evidence_refs"],
        "properties": {
          "suggestion_id": {"type": "string", "maxLength": 120},
          "description": {"type": "string", "maxLength": 1200},
          "expected_effect": {"type": "string", "maxLength": 800},
          "evidence_refs": {
            "type": "array",
            "items": {"type": "string", "maxLength": 120},
            "maxItems": 20
          }
        }
      },
      "maxItems": 20
    },
    "logging_gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gap_id", "description", "severity", "evidence_refs"],
        "properties": {
          "gap_id": {"type": "string", "maxLength": 120},
          "description": {"type": "string", "maxLength": 1000},
          "severity": {"type": "string", "enum": ["low", "medium", "high"]},
          "evidence_refs": {
            "type": "array",
            "items": {"type": "string", "maxLength": 120},
            "maxItems": 20
          }
        }
      },
      "maxItems": 20
    },
    "prioritized_improvements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item_id", "priority", "description", "owner_hint", "high_impact", "requires_operator_confirmation", "evidence_refs"],
        "properties": {
          "item_id": {"type": "string", "maxLength": 120},
          "priority": {"type": "string", "enum": ["p0", "p1", "p2", "p3"]},
          "description": {"type": "string", "maxLength": 1200},
          "owner_hint": {"type": "string", "maxLength": 120},
          "high_impact": {"type": "boolean"},
          "requires_operator_confirmation": {"type": "boolean"},
          "evidence_refs": {
            "type": "array",
            "items": {"type": "string", "maxLength": 120},
            "maxItems": 20
          }
        }
      },
      "maxItems": 25
    }
  }
}
